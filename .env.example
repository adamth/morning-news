# Copy to .env and fill in. docker-compose reads this automatically.

# Optional: force a canonical public URL for RSS enclosures (e.g. https://news.example.com).
# When unset, URLs are derived from each incoming request (Host / X-Forwarded-* headers).
# BASE_URL=https://news.example.com

# Random secret that signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Text-to-speech (required for audio). https://elevenlabs.io
ELEVENLABS_API_KEY=

# LLM gateway used for story selection + script writing. https://openrouter.ai
OPENROUTER_API_KEY=

# Optional: article-fetch fallback for paywalled / JS-heavy pages. https://www.zyte.com
ZYTE_API_KEY=

# Optional: finer-grained local news. https://newsdata.io
NEWSDATA_API_KEY=

# Stock watch quotes (required if you enable stock watch). Free at https://finnhub.io
FINNHUB_API_KEY=

# First-run login. Used only when no users exist yet; change the password after.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me

# Docker Hub image (e.g. youruser/morning-news). Used by npm run unraid:push and docker compose.
# DOCKER_IMAGE=youruser/morning-news

# Data persistence (Docker Compose):
# By default, compose stores /data in the named volume "morning-news-data".
# To bind a host directory instead, copy docker-compose.override.example.yml to
# docker-compose.override.yml and edit the path.
