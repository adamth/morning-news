# Copy to .env and fill in. docker-compose reads this automatically.

# Docker Hub image for `npm run docker:publish` (e.g. youruser/morning-news).
# DOCKER_IMAGE=youruser/morning-news

# Optional: force a canonical public URL for RSS enclosures (e.g. https://news.example.com).
# When unset, URLs are derived from each incoming request (Host / X-Forwarded-* headers).
# BASE_URL=https://news.example.com

# Required: random secret that signs session cookies and encrypts API keys in the database.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# First-run login. Used only when no users exist yet; change the password after.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=change-me

# API keys — normally added in the web UI under Settings → Connections (encrypted in SQLite).
# Environment variables below override saved keys when set (optional; useful for Docker automation).

# ELEVENLABS_API_KEY=
# SPEECHIFY_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_PROVIDER=openrouter
# ZYTE_API_KEY=
# FINNHUB_API_KEY=
# WEATHERAPI_API_KEY=
# NEWSDATA_API_KEY=