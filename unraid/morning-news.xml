<?xml version="1.0"?>
<Container version="2">
  <Name>MorningNews</Name>
  <Repository>youruser/morning-news:latest</Repository>
  <Registry>https://hub.docker.com/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/</Support>
  <Project>https://github.com/</Project>
  <Overview>Self-hosted daily news podcast generator with RSS feed. Requires a persistent /data mount or the database is wiped on every image update.</Overview>
  <Category>MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <Requires/>
  <Config Name="AppData" Target="/data" Default="/mnt/user/appdata/morning-news" Mode="rw" Type="Path" Display="always" Required="true" Description="Database, episodes, and uploads. Required — without this mapping, every update starts fresh."/>
  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always" Required="true" Description="Web UI and RSS feed"/>
  <Config Name="SESSION_SECRET" Target="SESSION_SECRET" Default="" Mode="" Type="Variable" Display="always" Required="true" Description="Random secret for login cookies"/>
  <Config Name="ELEVENLABS_API_KEY" Target="ELEVENLABS_API_KEY" Default="" Mode="" Type="Variable" Display="always" Required="false" Description="ElevenLabs text-to-speech"/>
  <Config Name="OPENROUTER_API_KEY" Target="OPENROUTER_API_KEY" Default="" Mode="" Type="Variable" Display="always" Required="false" Description="OpenRouter LLM gateway"/>
  <Config Name="BOOTSTRAP_USERNAME" Target="BOOTSTRAP_USERNAME" Default="admin" Mode="" Type="Variable" Display="always" Required="false" Description="First-run admin username (only when no users exist)"/>
  <Config Name="BOOTSTRAP_PASSWORD" Target="BOOTSTRAP_PASSWORD" Default="" Mode="" Type="Variable" Display="always" Required="false" Description="First-run admin password"/>
  <Config Name="BASE_URL" Target="BASE_URL" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Description="Optional public URL for RSS links"/>
  <Config Name="ZYTE_API_KEY" Target="ZYTE_API_KEY" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Description="Optional article-fetch fallback"/>
  <Config Name="NEWSDATA_API_KEY" Target="NEWSDATA_API_KEY" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Description="Optional local news API"/>
  <Config Name="FINNHUB_API_KEY" Target="FINNHUB_API_KEY" Default="" Mode="" Type="Variable" Display="advanced" Required="false" Description="Stock watch quotes"/>
</Container>
